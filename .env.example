# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./bridgelayer.db

# --- Zoho CRM OAuth2 ---
# Create a Server-based Application at https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:8000/zoho/auth/callback
# Accounts domain varies by data center (.com, .eu, .in, .com.au, ...)
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com

# --- Shopify Admin API ---
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-07
# Optional: only needed if you enable webhook verification
SHOPIFY_WEBHOOK_SECRET=
